# Telegram bot token from @BotFather
BOT_TOKEN=123456:REPLACE_WITH_REAL_TOKEN

# Comma-separated Telegram user IDs allowed to use owner/admin commands
ADMIN_IDS=

# Database connection (async SQLAlchemy URL). SQLite is fine for MVP.
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Telegram Mini App URL (leave empty to hide the Mini App button until it exists)
MINI_APP_URL=

# API key for free-form question answers (function 7). Leave empty to keep
# the built-in mock reply instead of calling a real LLM.
DEEPSEEK_API_KEY=

# Optional: point function 7 at a different OpenAI-compatible provider
# (OpenRouter, Groq, Together, a local model...) instead of DeepSeek — put
# that provider's key in DEEPSEEK_API_KEY above and fill these two in.
# Both empty = DeepSeek's own endpoint and model. Example for OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
#   LLM_MODEL=deepseek/deepseek-chat
LLM_BASE_URL=
LLM_MODEL=

# Your Telegram @username, shown to a user after they tap "Получить
# бесплатные экспрессы" (uses ADMIN_IDS above to notify you who asked).
CONTACT_USERNAME=

# Boxing Data API key from RapidAPI (rapidapi.com/bengroves1993/api/boxing-data-api).
# Subscribe even to the free plan — without a subscription the key returns 403.
# When set, the "Бокс" sport switches from demo fights to the real upcoming
# schedule (the free plan only covers a short window of days ahead/back).
# MMA and odds/coefficients are unaffected — this provider doesn't cover them.
BOXING_DATA_API_KEY=

# Port for the small read-only HTTP API the Mini App (docs/) fetches live
# event data from. Must be reachable over HTTPS from wherever docs/ is
# hosted (e.g. behind a reverse proxy) for the Mini App to see real data —
# see the "Реальные данные: бокс" section of the README.
MINI_APP_API_PORT=8080

# HTTP(S) proxy for the bot's own outbound requests (Telegram API, Boxing Data
# API). Only needed if a system-wide VPN/proxy client (V2Ray, Clash, etc.)
# handles your normal internet access — Python doesn't pick that up on its
# own the way a browser does, so without this the bot can time out reaching
# api.telegram.org, or RapidAPI can return HTTP 451 (region blocked) even
# though the same address works fine in your browser. Leave empty otherwise.
# Example: PROXY_URL=http://127.0.0.1:10809
PROXY_URL=
