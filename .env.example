# Telegram bot token from @BotFather
BOT_TOKEN=123456:REPLACE_WITH_REAL_TOKEN

# Comma-separated Telegram user IDs allowed to use owner/admin commands
ADMIN_IDS=

# Database connection (async SQLAlchemy URL). SQLite is fine for MVP.
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Telegram Mini App URL (leave empty to hide the Mini App button until it exists)
MINI_APP_URL=
