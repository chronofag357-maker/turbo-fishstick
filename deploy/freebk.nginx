limit_req_zone $binary_remote_addr zone=freebk:10m rate=2r/s;
server {
    listen 80;
    server_name 159-194-244-46.sslip.io;
    root /opt/freebk/app/docs;
    index mini-app.html;
    location ~ /\. { deny all; }
    location /api/ {
        limit_req zone=freebk burst=10 nodelay;
        proxy_pass http://127.0.0.1:8082;
        proxy_read_timeout 90s;
        proxy_set_header Host $host;
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }
}
